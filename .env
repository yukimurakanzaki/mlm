# Default (non-secret) settings for local development.
# Put real secrets in `.env.local` (git-ignored). See `.env.example`.

# Clerk authentication (placeholder publishable key, replace with your own in .env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk

# Database
# Local database with PGLite, already included in the project, no Docker needed
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Next.js
NEXT_TELEMETRY_DISABLED=1

# Logging
NEXT_PUBLIC_LOGGING_LEVEL=debug

######## [BEGIN] SENSITIVE DATA ######## This is a dummy value. Real secrets go in `.env.local`
CLERK_SECRET_KEY=sk_test_placeholder
######## [END] SENSITIVE DATA
