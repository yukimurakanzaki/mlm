# Non-secret production settings. Real secrets belong in your hosting provider's
# environment variables (or `.env.production.local`, which is git-ignored).

# Hosting: replace by the real domain name
NEXT_PUBLIC_APP_URL=https://example.com

# Logging
NEXT_PUBLIC_LOGGING_LEVEL=info

######## [BEGIN] SENSITIVE DATA ######## Set these in the hosting provider, never here
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Error monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORGANIZATION=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
######## [END] SENSITIVE DATA
