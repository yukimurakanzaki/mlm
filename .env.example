# Copy to `.env.local` and fill in. Never commit real secrets.

# Clerk (https://dashboard.clerk.com) - create an application, copy both keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Database (Postgres). Local dev uses PGLite automatically via `npm run dev`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Public URL of the site (production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Midtrans online payments (https://dashboard.midtrans.com). Leave empty to disable the "Pay online" button.
# Use the Sandbox server key while testing; set MIDTRANS_IS_PRODUCTION=true only with the Production key.
# In Midtrans: Settings > Payment > Notification URL = <your site>/api/payments/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
